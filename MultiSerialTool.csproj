<Project Sdk="Microsoft.NET.Sdk" InitialTargets="CalculateVersion">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net9.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>

    <!-- 主、次版本号仅在无 tag 时作为回退；正式版本号由 Git tag（vX.Y.Z）决定，见下方 CalculateVersion -->
    <VersionMajor>1</VersionMajor>
    <VersionMinor>0</VersionMinor>
    <!-- 输出 exe 名固定（WPF 临时编译程序集不支持动态 AssemblyName，固定名也让 OTA 替换更简单） -->
    <AssemblyName>MultiSerialTool-hfl</AssemblyName>
    <!-- exe 文件属性（右键 → 属性 → 详细信息），版本号由 CalculateVersion 动态注入 -->
    <Product>MultiSerialTool-$(Version)-hfl</Product>
    <AssemblyTitle>MultiSerialTool-$(Version)-hfl</AssemblyTitle>
    <Company>hfl</Company>
  </PropertyGroup>

  <!-- Tests 是独立子项目，其源码与 obj 下自动生成的 AssemblyInfo 不得被主项目默认 glob 编译，否则 CS0579 重复特性 -->
  <ItemGroup>
    <Compile Remove="Tests\**\*.cs" />
    <Page Remove="Tests\**\*.xaml" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="DevExpress.Images" Version="24.2.8" />
    <PackageReference Include="devexpress.wpf.carousel" Version="24.2.8" />
    <PackageReference Include="DevExpress.Wpf.Charts" Version="24.2.8" />
    <PackageReference Include="DevExpress.Wpf.Core" Version="24.2.8" />
    <PackageReference Include="DevExpress.Wpf.Grid" Version="24.2.8" />
    <PackageReference Include="DevExpress.Wpf.LayoutControl" Version="24.2.8" />
    <PackageReference Include="devexpress.wpf.ribbon" Version="24.2.8" />
    <PackageReference Include="HandyControl" Version="3.5.1" />
    <PackageReference Include="NLog" Version="6.2.2" />
    <PackageReference Include="ScottPlot.WPF" Version="5.1.59" />
    <PackageReference Include="System.IO.Ports" Version="10.0.14" />
    <PackageReference Include="System.Management" Version="10.0.14" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="Assets\Icons\*.svg" />
    <!-- 语言包作为静态资源嵌入程序集，运行时通过 pack URI 读取，不依赖外部文件 -->
    <Resource Include="Assets\Languages\*.json" />
  </ItemGroup>

  <!-- 版本更新历史：复制到输出目录 Changelog，可外部替换，改 JSON 即生效、无需重新编译 -->
  <ItemGroup>
    <None Include="Assets\Changelog\*.json">
      <Link>Changelog\%(Filename)%(Extension)</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

  <!-- 设备解析规则：复制到输出目录 DeviceRules，下拉框按文件名扫描，可外部增删替换 -->
  <ItemGroup>
    <None Include="Assets\DeviceRules\*.json">
      <Link>DeviceRules\%(Filename)%(Extension)</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

  <!-- NLog 配置：复制到输出目录，可外部调整队列/归档参数，无需重新编译 -->
  <ItemGroup>
    <None Include="nlog.config">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

  <!--
    自动版本号：版本号唯一权威来源是 Git tag（形如 v1.0.5）。
    日常 commit 不再改变版本号，只有新增 tag 才产生新版本；无 tag 时回退为 主版本.次版本.提交数。
    工作区有未提交改动时，InformationalVersion 追加 -dev 标记测试包。
  -->
  <Target Name="CalculateVersion">
    <!-- 2>nul 必须保留：无 tag 时 git 会把 "fatal: No names found..." 写到 stderr，
         Exec 的 ConsoleToMSBuild 会把它并进 ConsoleOutput，导致版本号被污染 -->
    <Exec Command="git describe --tags --abbrev=0 --match &quot;v*&quot; 2&gt;nul" ConsoleToMSBuild="true" WorkingDirectory="$(MSBuildProjectDirectory)" IgnoreExitCode="true" StandardOutputImportance="low" StandardErrorImportance="low">
      <Output TaskParameter="ConsoleOutput" PropertyName="GitTag" />
    </Exec>
    <Exec Command="git rev-list --count HEAD" ConsoleToMSBuild="true" WorkingDirectory="$(MSBuildProjectDirectory)" IgnoreExitCode="true" StandardOutputImportance="low" StandardErrorImportance="low">
      <Output TaskParameter="ConsoleOutput" PropertyName="GitCommitCount" />
    </Exec>
    <Exec Command="git describe --always --dirty" ConsoleToMSBuild="true" WorkingDirectory="$(MSBuildProjectDirectory)" IgnoreExitCode="true" StandardOutputImportance="low" StandardErrorImportance="low">
      <Output TaskParameter="ConsoleOutput" PropertyName="GitDescribe" />
    </Exec>

    <PropertyGroup>
      <PatchVersion Condition="'$(GitCommitCount)' != ''">$(GitCommitCount)</PatchVersion>
      <PatchVersion Condition="'$(GitCommitCount)' == ''">0</PatchVersion>
      <!-- tag 去掉前导 v：v1.0.5 → 1.0.5 -->
      <GitTagVersion Condition="'$(GitTag)' != ''">$(GitTag)</GitTagVersion>
      <GitTagVersion Condition="'$(GitTag)' != '' and $(GitTag.StartsWith('v'))">$([System.String]::Copy('$(GitTag)').Substring(1))</GitTagVersion>
      <!-- 同一 PropertyGroup 内顺序求值：先定 Version，再展开引用它的 Product 等字符串属性 -->
      <Version Condition="'$(GitTagVersion)' != ''">$(GitTagVersion)</Version>
      <Version Condition="'$(GitTagVersion)' == ''">$(VersionMajor).$(VersionMinor).$(PatchVersion)</Version>
      <Product>MultiSerialTool-$(Version)-hfl</Product>
      <AssemblyTitle>MultiSerialTool-$(Version)-hfl</AssemblyTitle>
      <!-- AssemblyVersion/FileVersion 必须四段数字，tag 统一用 vX.Y.Z，缺失时回退到提交数版本 -->
      <AssemblyVersion Condition="'$(GitTagVersion)' != ''">$(GitTagVersion).0</AssemblyVersion>
      <AssemblyVersion Condition="'$(GitTagVersion)' == ''">$(VersionMajor).$(VersionMinor).$(PatchVersion).0</AssemblyVersion>
      <FileVersion Condition="'$(GitTagVersion)' != ''">$(GitTagVersion).0</FileVersion>
      <FileVersion Condition="'$(GitTagVersion)' == ''">$(VersionMajor).$(VersionMinor).$(PatchVersion).0</FileVersion>
      <!-- describe 结果同样去掉前导 v；无 .git 或未安装 git 时给占位值 -->
      <GitDescribeClean Condition="'$(GitDescribe)' != '' and $(GitDescribe.StartsWith('v'))">$([System.String]::Copy('$(GitDescribe)').Substring(1))</GitDescribeClean>
      <GitDescribeClean Condition="'$(GitDescribe)' != '' and !$(GitDescribe.StartsWith('v'))">$(GitDescribe)</GitDescribeClean>
      <GitDescribeClean Condition="'$(GitDescribe)' == ''">nogit</GitDescribeClean>
      <!-- 干净工作区：1.0.5+2-g6778a73；有未提交改动：1.0.5-dev+2-g6778a73-dirty -->
      <InformationalVersion Condition="!$(GitDescribeClean.EndsWith('-dirty'))">$(Version)+$(GitDescribeClean)</InformationalVersion>
      <InformationalVersion Condition="$(GitDescribeClean.EndsWith('-dirty'))">$(Version)-dev+$(GitDescribeClean)</InformationalVersion>
    </PropertyGroup>
  </Target>

</Project>
