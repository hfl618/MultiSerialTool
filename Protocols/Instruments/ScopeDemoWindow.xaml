<Window x:Class="MultiSerialTool.Protocols.Instruments.ScopeDemoWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:dx="http://schemas.devexpress.com/winfx/2008/xaml/core"
        xmlns:dxe="http://schemas.devexpress.com/winfx/2008/xaml/editors"
        xmlns:dxg="http://schemas.devexpress.com/winfx/2008/xaml/grid"
        xmlns:dxlc="http://schemas.devexpress.com/winfx/2008/xaml/layoutcontrol"
        xmlns:sp="clr-namespace:ScottPlot.WPF;assembly=ScottPlot.WPF"
        xmlns:dxb="http://schemas.devexpress.com/winfx/2008/xaml/bars"

        Title="MDO3024 示波器实时采集 - DevExpress + ScottPlot"
        Icon="/Assets/Icons/app.ico"
        Width="1280" Height="820"
        WindowStartupLocation="CenterScreen">
 
    
    <DockPanel Margin="8">
        <!-- ========== 顶部按键行 ========== -->
        <Border DockPanel.Dock="Top" BorderBrush="#CCCCCC" BorderThickness="1"
                Background="#F0F0F0" Padding="8,6" Margin="0,0,0,6">
            <Grid>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">

                    <TextBlock Text="IP" VerticalAlignment="Center" Margin="2,0,4,0"/>
                    <TextBox x:Name="HostBox" Width="110" Text="192.168.2.100"
                             VerticalAlignment="Center" Margin="0,0,6,0"
                             ToolTip="示波器 LAN 地址（网线直连，192.168.2.100）"/>
                    <TextBlock Text="端口" VerticalAlignment="Center" Margin="0,0,4,0"/>
                    <TextBox x:Name="PortBox" Width="52" Text="4000"
                             VerticalAlignment="Center" Margin="0,0,10,0"
                             ToolTip="SCPI Socket Server 端口（默认 4000）"/>

                    <!-- 连接：Toggle 按钮，ON/OFF 不同图标，仅图标无文字 -->
                    <dx:SimpleButton x:Name="BtnConnect" ButtonKind="Toggle"
                                     GlyphWidth="24" GlyphHeight="24" Margin="0,0,8,0"
                                     ToolTip="连接 / 断开"
                                     Click="BtnConnect_Click">
                        <dx:SimpleButton.Style>
                            <Style TargetType="dx:SimpleButton">
                                <Setter Property="Glyph" Value="{dx:SvgImageSource Uri='/Assets/Icons/OFF_Connect.svg'}"/>
                                <Style.Triggers>
                                    <Trigger Property="IsChecked" Value="True">
                                        <Setter Property="Glyph" Value="{dx:SvgImageSource Uri='/Assets/Icons/ON_Connect.svg'}"/>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </dx:SimpleButton.Style>
                    </dx:SimpleButton>

                    <dx:SimpleButton x:Name="BtnStart" GlyphWidth="24" GlyphHeight="24"
                                     Glyph="{dx:SvgImageSource Uri='/Assets/Icons/ON_power.svg'}"
                                     ToolTip="开始" Margin="0,0,8,0" Click="BtnStart_Click"/>

                    <!-- 暂停：Toggle 按钮，ON/OFF 不同图标，仅图标无文字 -->
                    <dx:SimpleButton x:Name="BtnPause" ButtonKind="Toggle"
                                     GlyphWidth="24" GlyphHeight="24" Margin="0,0,8,0"
                                     ToolTip="暂停 / 继续"
                                     Click="BtnPause_Click">
                        <dx:SimpleButton.Style>
                            <Style TargetType="dx:SimpleButton">
                                <Setter Property="Glyph" Value="{dx:SvgImageSource Uri='/Assets/Icons/pause-one.svg'}"/>
                                <Style.Triggers>
                                    <Trigger Property="IsChecked" Value="True">
                                        <Setter Property="Glyph" Value="{dx:SvgImageSource Uri='/Assets/Icons/ON_pause-one.svg'}"/>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </dx:SimpleButton.Style>
                    </dx:SimpleButton>

                    <dx:SimpleButton x:Name="BtnClear" GlyphWidth="24" GlyphHeight="24"
                                     Glyph="{dx:SvgImageSource Uri='/Assets/Icons/clear.svg'}"
                                     ToolTip="清空" Margin="0,0,8,0" Click="BtnClear_Click"/>

                    <dx:SimpleButton x:Name="BtnExport" GlyphWidth="24" GlyphHeight="24"
                                     Glyph="{dx:SvgImageSource Uri='/Assets/Icons/export.svg'}"
                                     ToolTip="导出" Margin="0,0,8,0" Click="BtnExport_Click"/>

                    <dx:SimpleButton x:Name="BtnScreenshot" GlyphWidth="24" GlyphHeight="24"
                                     Glyph="{dx:SvgImageSource Uri='/Assets/Icons/screenshot.svg'}"
                                     ToolTip="截图（图表 + 数据表，复制到剪贴板）" Click="BtnScreenshot_Click"/>
                </StackPanel>

                <!-- 设备信息 -->
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <dx:SimpleButton x:Name="ConnLed" GlyphWidth="18" GlyphHeight="18"
                                     Glyph="{dx:SvgImageSource Uri='/Assets/Icons/OFF_Connect.svg'}"
                                     IsEnabled="False"/>
                    <TextBlock x:Name="DeviceInfo" VerticalAlignment="Center" Margin="8,0,0,0"
                               Text="未连接 | 型号 -- | 采样率 -- | 记录长度 --"/>
                </StackPanel>
            </Grid>
        </Border>
        
        <!-- ========== 水平功能看板 ========== -->
        <Border DockPanel.Dock="Right" Width="340"
                BorderThickness="1" Margin="0,0,0,6">
            <dxlc:LayoutControl Padding="8" View="Group" Orientation="Vertical">
                <dxlc:LayoutGroup Header="通道选择" View="GroupBox" Height="70">
                    <dxe:CheckEdit x:Name="Ch1Enabled" Content="CH1" IsChecked="True"
                                   Checked="Channel_Changed" Unchecked="Channel_Changed"/>
                    <dxe:CheckEdit x:Name="Ch2Enabled" Content="CH2" IsChecked="True"
                                   Checked="Channel_Changed" Unchecked="Channel_Changed"/>
                    <dxe:CheckEdit x:Name="Ch3Enabled" Content="CH3" IsChecked="True"
                                   Checked="Channel_Changed" Unchecked="Channel_Changed"/>
                    <dxe:CheckEdit x:Name="Ch4Enabled" Content="CH4" IsChecked="True"
                                   Checked="Channel_Changed" Unchecked="Channel_Changed"/>
                </dxlc:LayoutGroup>

                <dxlc:LayoutGroup Header="光标测量" View="GroupBox" Height="140">
                    <StackPanel Margin="2">

                        <!-- 垂直光标：时间（单行） -->
                        <StackPanel Orientation="Horizontal" Margin="0,2,0,4">
                            <dxe:CheckEdit x:Name="VCursorEnable" Content="垂直光标" IsChecked="True"
                           VerticalAlignment="Center" Margin="0,0,8,0"
                           Checked="Cursor_Changed" Unchecked="Cursor_Changed"/>
                            <TextBlock Text="A" VerticalAlignment="Center" Margin="4,0,2,0"/>
                            <TextBlock x:Name="VTimeA" Text="--" Width="48" VerticalAlignment="Center"/>
                            <TextBlock Text="B" VerticalAlignment="Center" Margin="4,0,2,0"/>
                            <TextBlock x:Name="VTimeB" Text="--" Width="48" VerticalAlignment="Center"/>
                            <TextBlock Text="Δt" VerticalAlignment="Center" Margin="4,0,2,0"/>
                            <TextBlock x:Name="VTimeDelta" Text="--" Width="48" VerticalAlignment="Center" FontWeight="Bold"/>
                        </StackPanel>

                        <!-- 水平光标：电压（单行） -->
                        <StackPanel Orientation="Horizontal" Margin="0,2,0,4">
                            <dxe:CheckEdit x:Name="HCursorEnable" Content="水平光标" IsChecked="True"
                           VerticalAlignment="Center" Margin="0,0,8,0"
                           Checked="Cursor_Changed" Unchecked="Cursor_Changed"/>
                            <TextBlock Text="A" VerticalAlignment="Center" Margin="4,0,2,0"/>
                            <TextBlock x:Name="HVoltA" Text="--" Width="48" VerticalAlignment="Center"/>
                            <TextBlock Text="B" VerticalAlignment="Center" Margin="4,0,2,0"/>
                            <TextBlock x:Name="HVoltB" Text="--" Width="48" VerticalAlignment="Center"/>
                            <TextBlock Text="ΔV" VerticalAlignment="Center" Margin="4,0,2,0"/>
                            <TextBlock x:Name="HVoltDelta" Text="--" Width="48" VerticalAlignment="Center" FontWeight="Bold"/>
                        </StackPanel>

                        <!-- ===== 限值预警（内嵌在光标分组内） ===== -->
                            <StackPanel Orientation="Horizontal" Margin="0,4">
                            <dxe:CheckEdit x:Name="LimitEnable" Content="限值  " IsChecked="False"
                               VerticalAlignment="Center" Margin="0,0,0,4"
                               Checked="Limit_Changed" Unchecked="Limit_Changed"/>
                            <dxe:ComboBoxEdit x:Name="LimitTarget" Width="50" IsTextEditable="False" SelectedIndex="0">
                                    <dxe:ComboBoxEditItem Content="ΔV"/>
                                    <dxe:ComboBoxEditItem Content="Δt"/>
                                </dxe:ComboBoxEdit>
                                <TextBlock Text="上限" VerticalAlignment="Center" Margin="8,0,2,0"/>
                                <dxe:SpinEdit x:Name="LimitUpper" Width="42"
                  MinValue="-10000" MaxValue="10000" Increment="0.1" EditValue="0"
                  Mask="F3" MaskType="Numeric" EditValueChanged="Limit_Changed"/>
                                <TextBlock Text="下限" VerticalAlignment="Center" Margin="8,0,2,0"/>
                                <dxe:SpinEdit x:Name="LimitLower" Width="42"
                  MinValue="-10000" MaxValue="10000" Increment="0.1" EditValue="0"
                  Mask="F3" MaskType="Numeric" EditValueChanged="Limit_Changed"/>
                            </StackPanel>

                       
                    </StackPanel>
                </dxlc:LayoutGroup>



                <!-- ========== 示波器调试（Tab 内嵌 4 通道，选中 Tab 即触发源） ========== -->
                <dxlc:LayoutGroup Header="示波器调试" View="GroupBox" Height="230">
                    <StackPanel Margin="2">

                        <!-- 4 个通道各自的边沿 + 电平（同一行） -->
                        <dx:DXTabControl x:Name="TrigTab" Height="92" SelectedIndex="0">

                            <dx:DXTabItem Header="CH1">
                                <StackPanel Orientation="Horizontal" Margin="4,8,4,4">
                                    <TextBlock Text="边沿" VerticalAlignment="Center" Margin="0,0,4,0"/>
                                    <dxe:ComboBoxEdit x:Name="TrigSlope_CH1" Width="70" IsTextEditable="False" SelectedIndex="0">
                                        <dxe:ComboBoxEditItem Content="上升"/>
                                        <dxe:ComboBoxEditItem Content="下降"/>
                                    </dxe:ComboBoxEdit>
                                    <TextBlock Text="电平(V)" VerticalAlignment="Center" Margin="8,0,4,0"/>
                                    <dxe:SpinEdit x:Name="TrigLevel_CH1" Width="50"
                                  MinValue="-100" MaxValue="100" Increment="0.1" EditValue="0"
                                  Mask="F4" MaskType="Numeric"/>
                                </StackPanel>
                            </dx:DXTabItem>

                            <dx:DXTabItem Header="CH2">
                                <StackPanel Orientation="Horizontal" Margin="4,8,4,4">
                                    <TextBlock Text="边沿" VerticalAlignment="Center" Margin="0,0,4,0"/>
                                    <dxe:ComboBoxEdit x:Name="TrigSlope_CH2" Width="70" IsTextEditable="False" SelectedIndex="0">
                                        <dxe:ComboBoxEditItem Content="上升"/>
                                        <dxe:ComboBoxEditItem Content="下降"/>
                                    </dxe:ComboBoxEdit>
                                    <TextBlock Text="电平(V)" VerticalAlignment="Center" Margin="8,0,4,0"/>
                                    <dxe:SpinEdit x:Name="TrigLevel_CH2" Width="50"
                                  MinValue="-100" MaxValue="100" Increment="0.1" EditValue="0"
                                  Mask="F4" MaskType="Numeric"/>
                                </StackPanel>
                            </dx:DXTabItem>

                            <dx:DXTabItem Header="CH3">
                                <StackPanel Orientation="Horizontal" Margin="4,8,4,4">
                                    <TextBlock Text="边沿" VerticalAlignment="Center" Margin="0,0,4,0"/>
                                    <dxe:ComboBoxEdit x:Name="TrigSlope_CH3" Width="70" IsTextEditable="False" SelectedIndex="0">
                                        <dxe:ComboBoxEditItem Content="上升"/>
                                        <dxe:ComboBoxEditItem Content="下降"/>
                                    </dxe:ComboBoxEdit>
                                    <TextBlock Text="电平(V)" VerticalAlignment="Center" Margin="8,0,4,0"/>
                                    <dxe:SpinEdit x:Name="TrigLevel_CH3" Width="50"
                                  MinValue="-100" MaxValue="100" Increment="0.1" EditValue="0"
                                  Mask="F4" MaskType="Numeric"/>
                                </StackPanel>
                            </dx:DXTabItem>

                            <dx:DXTabItem Header="CH4">
                                <StackPanel Orientation="Horizontal" Margin="4,8,4,4">
                                    <TextBlock Text="边沿" VerticalAlignment="Center" Margin="0,0,4,0"/>
                                    <dxe:ComboBoxEdit x:Name="TrigSlope_CH4" Width="70" IsTextEditable="False" SelectedIndex="0">
                                        <dxe:ComboBoxEditItem Content="上升"/>
                                        <dxe:ComboBoxEditItem Content="下降"/>
                                    </dxe:ComboBoxEdit>
                                    <TextBlock Text="电平(V)" VerticalAlignment="Center" Margin="8,0,4,0"/>
                                    <dxe:SpinEdit x:Name="TrigLevel_CH4" Width="50"
                                  MinValue="-100" MaxValue="100" Increment="0.1" EditValue="0"
                                  Mask="F4" MaskType="Numeric"/>
                                </StackPanel>
                            </dx:DXTabItem>
                        </dx:DXTabControl>

                        <!-- 全局：触发模式 + 触发停止 + 强制触发 -->
                        <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                            <dxe:ComboBoxEdit x:Name="TrigMode" Width="120" IsTextEditable="False" SelectedIndex="0">
                                <dxe:ComboBoxEditItem Content="Auto"/>
                                <dxe:ComboBoxEditItem Content="Normal"/>
                                <dxe:ComboBoxEditItem Content="单次 Single"/>
                            </dxe:ComboBoxEdit>
                            <dx:SimpleButton x:Name="BtnTriggerStop" Width="80" Margin="6,0,0,0" Content="触发停止"
                             Click="BtnTriggerStop_Click"/>
                            <dx:SimpleButton x:Name="BtnForce" Width="80" Margin="6,0,0,0" Content="强制触发"
                             ToolTip="发送 :TRIGger FORCe，强制产生一次触发"
                             Click="BtnForce_Click"/>
                        </StackPanel>

                        <!-- 手动重新下发当前触发配置 -->
                        <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                            <dx:SimpleButton x:Name="BtnApplyTrigger" Width="100" Content="应用触发"
                             ToolTip="把当前触发类型/源/斜率/电平/模式重新下发到示波器"
                             Click="BtnApplyTrigger_Click"/>
                            <TextBlock Text="重新下发当前触发配置" VerticalAlignment="Center"
                             Margin="6,0,0,0" Foreground="#888888"/>
                        </StackPanel>

                        <!-- 硬件触发实际状态回读 -->
                        <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                            <dx:SimpleButton x:Name="HwTrigLed" GlyphWidth="16" GlyphHeight="16"
                             Glyph="{dx:SvgImageSource Uri='/Assets/Icons/OFF_Connect.svg'}"
                             IsEnabled="False"/>
                            <TextBlock x:Name="HwTrigState" VerticalAlignment="Center" Margin="6,0,0,0"
                       Text="硬件触发: --" Foreground="#666666"/>
                        </StackPanel>
                    </StackPanel>
                </dxlc:LayoutGroup>


                <dxlc:LayoutGroup Header="显示设置" View="GroupBox" Height="100">
                    <StackPanel Orientation="Horizontal" Margin="2">
                        <dxe:CheckEdit x:Name="CursorEnable" Content="光标" IsChecked="True"
                                       VerticalAlignment="Center" Margin="0,0,8,0"
                                       ToolTip="启用光标拖拽"
                                       Checked="Cursor_Changed" Unchecked="Cursor_Changed"/>
                        <TextBlock Text="时间" VerticalAlignment="Center" Margin="0,0,4,0"/>
                        <dxe:SpinEdit x:Name="TimePerDivision" Width="76"
                                      MinValue="0.000000001" MaxValue="100" Increment="0.000001"
                                      ToolTip="时间/格 (s)，连接后与示波器双向同步"
                                      VerticalAlignment="Center" Margin="0,0,8,0"
                                      EditValueChanged="Scale_Changed"/>
                        <TextBlock Text="电压" VerticalAlignment="Center" Margin="0,0,4,0"/>
                        <dxe:SpinEdit x:Name="VoltPerDivision" Width="68"
                                      MinValue="0.000001" MaxValue="1000" Increment="0.1"
                                      ToolTip="电压/格 (V)，连接后与触发源通道同步"
                                      VerticalAlignment="Center" Margin="0,0,8,0"
                                      EditValueChanged="Scale_Changed"/>
                        <TextBlock x:Name="WindowText" Text="1000 点" VerticalAlignment="Center"/>
                    </StackPanel>
                </dxlc:LayoutGroup>

            </dxlc:LayoutControl>
        </Border>
        <!-- ========== 底部状态栏 ========== -->
        <Border DockPanel.Dock="Bottom" BorderBrush="#CCCCCC" BorderThickness="1"
                Background="#F8F8F8" Padding="8,4" Margin="0,6,0,0">
            <TextBlock x:Name="ClockItem" Text="--"/>
        </Border>

        <!-- ========== 主区域 ========== -->
        <Grid x:Name="CaptureArea">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="163*"/>
                <ColumnDefinition Width="801*"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="280"/>
            </Grid.RowDefinitions>

            <Border Grid.Row="0" BorderBrush="#CCCCCC" BorderThickness="1" Grid.ColumnSpan="2" Margin="0,0,0,6" Grid.RowSpan="2">
                <sp:WpfPlot x:Name="ScopePlot" Margin="4"/>
            </Border>

            <GridSplitter Grid.Row="1" Height="6" HorizontalAlignment="Stretch"
                         Background="Transparent" ResizeBehavior="PreviousAndNext" Grid.ColumnSpan="2" Margin="0,0,0,280" Grid.RowSpan="2"/>

            <DockPanel Grid.Row="2" Grid.ColumnSpan="2">
                <!-- ===== 表格通道切换（4 选 1） + 测量项目弹窗按钮 ===== -->
                <Grid DockPanel.Dock="Top" Margin="0,0,0,4">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                        <TextBlock Text="Channel:" VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <RadioButton x:Name="RbCh1" Content="CH1" GroupName="MeasureChannel" IsChecked="True" Margin="0,0,12,0" VerticalAlignment="Center" Checked="MeasureChannel_Checked"/>
                        <RadioButton x:Name="RbCh2" Content="CH2" GroupName="MeasureChannel" Margin="0,0,12,0" VerticalAlignment="Center" Checked="MeasureChannel_Checked"/>
                        <RadioButton x:Name="RbCh3" Content="CH3" GroupName="MeasureChannel" Margin="0,0,12,0" VerticalAlignment="Center" Checked="MeasureChannel_Checked"/>
                        <RadioButton x:Name="RbCh4" Content="CH4" GroupName="MeasureChannel" VerticalAlignment="Center" Checked="MeasureChannel_Checked"/>
                    </StackPanel>

                    <dx:SimpleButton x:Name="BtnMeasureKinds" Content="Measures ▾"
                                     HorizontalAlignment="Right" Padding="10,2"
                                     ToolTip="Choose which measurement rows are shown"
                                     Click="BtnMeasureKinds_Click"/>
                </Grid>

                <!-- 测量项目选择弹窗：按数据来源分类 -->
                <Popup x:Name="MeasureKindsPopup"
                       PlacementTarget="{Binding ElementName=BtnMeasureKinds}"
                       Placement="Top" StaysOpen="False" AllowsTransparency="True"
                       PopupAnimation="Fade">
                    <Border Background="White" BorderBrush="#BBBBBB" BorderThickness="1"
                            Padding="12,10" Margin="0,0,0,4">
                        <Border.Effect>
                            <DropShadowEffect BlurRadius="12" ShadowDepth="2" Opacity="0.18"/>
                        </Border.Effect>
                        <ScrollViewer MaxHeight="480" VerticalScrollBarVisibility="Auto">
                            <StackPanel Width="360">
                            <TextBlock Text="Instrument MEAS (live SCPI)" FontWeight="Bold"
                                       Foreground="#1E88E5" Margin="0,0,0,4"/>
                            <UniformGrid Columns="3" Margin="0,0,0,10">
                                <dxe:CheckEdit Content="Frequency" Tag="Frequency" IsChecked="True" Checked="MeasureType_Changed" Unchecked="MeasureType_Changed"/>
                                <dxe:CheckEdit Content="Period" Tag="Period" IsChecked="False" Checked="MeasureType_Changed" Unchecked="MeasureType_Changed"/>
                                <dxe:CheckEdit Content="Rise time" Tag="Rise time" IsChecked="False" Checked="MeasureType_Changed" Unchecked="MeasureType_Changed"/>
                                <dxe:CheckEdit Content="Fall time" Tag="Fall time" IsChecked="False" Checked="MeasureType_Changed" Unchecked="MeasureType_Changed"/>
                                <dxe:CheckEdit Content="Pos width" Tag="Pos width" IsChecked="False" Checked="MeasureType_Changed" Unchecked="MeasureType_Changed"/>
                                <dxe:CheckEdit Content="Neg width" Tag="Neg width" IsChecked="False" Checked="MeasureType_Changed" Unchecked="MeasureType_Changed"/>
                                <dxe:CheckEdit Content="Duty +" Tag="Duty +" IsChecked="False" Checked="MeasureType_Changed" Unchecked="MeasureType_Changed"/>
                                <dxe:CheckEdit Content="Duty -" Tag="Duty -" IsChecked="False" Checked="MeasureType_Changed" Unchecked="MeasureType_Changed"/>
                                <dxe:CheckEdit Content="High" Tag="High" IsChecked="False" Checked="MeasureType_Changed" Unchecked="MeasureType_Changed"/>
                                <dxe:CheckEdit Content="Low" Tag="Low" IsChecked="False" Checked="MeasureType_Changed" Unchecked="MeasureType_Changed"/>
                                <dxe:CheckEdit Content="Amplitude" Tag="Amplitude" IsChecked="False" Checked="MeasureType_Changed" Unchecked="MeasureType_Changed"/>
                                <dxe:CheckEdit Content="Average" Tag="Average" IsChecked="True" Checked="MeasureType_Changed" Unchecked="MeasureType_Changed"/>
                                <dxe:CheckEdit Content="Max" Tag="Max" IsChecked="True" Checked="MeasureType_Changed" Unchecked="MeasureType_Changed"/>
                                <dxe:CheckEdit Content="Min" Tag="Min" IsChecked="False" Checked="MeasureType_Changed" Unchecked="MeasureType_Changed"/>
                                <dxe:CheckEdit Content="Peak-peak" Tag="Peak-peak" IsChecked="True" Checked="MeasureType_Changed" Unchecked="MeasureType_Changed"/>
                                <dxe:CheckEdit Content="RMS" Tag="RMS" IsChecked="False" Checked="MeasureType_Changed" Unchecked="MeasureType_Changed"/>
                                <dxe:CheckEdit Content="Cycle mean" Tag="Cycle mean" IsChecked="False" Checked="MeasureType_Changed" Unchecked="MeasureType_Changed"/>
                                <dxe:CheckEdit Content="Cycle RMS" Tag="Cycle RMS" IsChecked="False" Checked="MeasureType_Changed" Unchecked="MeasureType_Changed"/>
                                <dxe:CheckEdit Content="Pos overshoot" Tag="Pos overshoot" IsChecked="False" Checked="MeasureType_Changed" Unchecked="MeasureType_Changed"/>
                                <dxe:CheckEdit Content="Neg overshoot" Tag="Neg overshoot" IsChecked="False" Checked="MeasureType_Changed" Unchecked="MeasureType_Changed"/>
                                <dxe:CheckEdit Content="Area" Tag="Area" IsChecked="False" Checked="MeasureType_Changed" Unchecked="MeasureType_Changed"/>
                            </UniformGrid>

                            <Border Height="1" Background="#E5E5E5" Margin="0,0,0,8"/>

                            <TextBlock Text="Calculated on PC (local)" FontWeight="Bold"
                                       Foreground="#4CAF50" Margin="0,0,0,4"/>
                            <UniformGrid Columns="3">
                                <dxe:CheckEdit Content="Cursor a time" Tag="Cursor a time" IsChecked="False" Checked="MeasureType_Changed" Unchecked="MeasureType_Changed"/>
                                <dxe:CheckEdit Content="Cursor b time" Tag="Cursor b time" IsChecked="False" Checked="MeasureType_Changed" Unchecked="MeasureType_Changed"/>
                                <dxe:CheckEdit Content="Δt" Tag="Δt" IsChecked="True" Checked="MeasureType_Changed" Unchecked="MeasureType_Changed"/>
                                <dxe:CheckEdit Content="1/Δt" Tag="1/Δt" IsChecked="False" Checked="MeasureType_Changed" Unchecked="MeasureType_Changed"/>
                                <dxe:CheckEdit Content="Cursor a volt" Tag="Cursor a volt" IsChecked="False" Checked="MeasureType_Changed" Unchecked="MeasureType_Changed"/>
                                <dxe:CheckEdit Content="Cursor b volt" Tag="Cursor b volt" IsChecked="False" Checked="MeasureType_Changed" Unchecked="MeasureType_Changed"/>
                                <dxe:CheckEdit Content="ΔV" Tag="ΔV" IsChecked="False" Checked="MeasureType_Changed" Unchecked="MeasureType_Changed"/>
                            </UniformGrid>
                            </StackPanel>
                        </ScrollViewer>
                    </Border>
                </Popup>
                <dxg:GridControl x:Name="MeasureGrid"
                                 AutoGenerateColumns="None"
                                 EnableSmartColumnsGeneration="False">
                <dxg:GridControl.View>
                    <dxg:TableView ShowGroupPanel="False"
                                   AllowEditing="False"
                                   AllowColumnMoving="False"
                                   IsColumnMenuEnabled="False"/>
                </dxg:GridControl.View>
                <dxg:GridControl.Columns>
                    <dxg:GridColumn FieldName="MeasureType" Header="Measure" Width="150"/>
                    <dxg:GridColumn FieldName="Value" Header="Value" Width="*"/>
                    <dxg:GridColumn FieldName="Average" Header="Average" Width="*"/>
                    <dxg:GridColumn FieldName="Min" Header="Min" Width="*"/>
                    <dxg:GridColumn FieldName="Max" Header="Max" Width="*"/>
                    <dxg:GridColumn FieldName="StdDev" Header="StdDev" Width="*"/>
                    <dxg:GridColumn FieldName="Source" Header="Source" Width="125"/>
                    <dxg:GridColumn FieldName="UpdatedAt" Header="Updated" Width="130"/>
                </dxg:GridControl.Columns>
            </dxg:GridControl>
            </DockPanel>
        </Grid>
    </DockPanel>
</Window>
