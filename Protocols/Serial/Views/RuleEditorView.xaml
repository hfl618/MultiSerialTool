<UserControl x:Class="MultiSerialTool.Protocols.Serial.RuleEditorView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2006"
             xmlns:dxlc="http://schemas.devexpress.com/winfx/2008/xaml/layoutcontrol"
             xmlns:dxe="http://schemas.devexpress.com/winfx/2008/xaml/editors"
             xmlns:dx="http://schemas.devexpress.com/winfx/2008/xaml/core"
             xmlns:local="clr-namespace:MultiSerialTool.Protocols.Serial"
             xmlns:loc="clr-namespace:MultiSerialTool.Models.Localization"
             mc:Ignorable="d"
             d:DesignHeight="560" d:DesignWidth="820">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
    </UserControl.Resources>

    <!-- 窄窗口下整页可纵向滚动，横向由控件自身收缩/滚动，避免内容被裁掉 -->
    <ScrollViewer VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Disabled"
                  Focusable="False">
    <dxlc:LayoutControl Orientation="Vertical" ItemSpace="10" Margin="8">

        <!-- ========== 分组1：文件规则（每设备独立，跟随当前选中串口） ========== -->
        <dxlc:LayoutGroup Header="{loc:Translate 文件规则}"
                          View="GroupBox" Orientation="Vertical"
                          IsEnabled="{Binding HasDevice}">

            <!-- 标签在上、输入在下；按可用宽度自动折行，窄窗口不裁切 -->
            <dxlc:LayoutItem Label="{x:Null}">
                <WrapPanel Margin="0,2,0,0">
                    <StackPanel Width="140" Margin="0,0,12,10">
                        <TextBlock Text="{loc:Translate 启用实时写入}"
                                   Foreground="#666666" FontSize="11" Margin="0,0,0,3"
                                   TextTrimming="CharacterEllipsis"/>
                        <dxe:CheckEdit VerticalAlignment="Center"
                                       HorizontalAlignment="Left"
                                       IsChecked="{Binding RealtimeEnabled}"/>
                    </StackPanel>

                    <StackPanel Width="220" Margin="0,0,12,10">
                        <TextBlock Text="{loc:Translate 导出路径}"
                                   Foreground="#666666" FontSize="11" Margin="0,0,0,3"
                                   TextTrimming="CharacterEllipsis"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <dxe:TextEdit Grid.Column="0" Margin="0,0,4,0"
                                          VerticalAlignment="Center"
                                          Text="{Binding FileDirectory}"/>
                            <dx:SimpleButton Grid.Column="1"
                                             Width="28" Height="28"
                                             VerticalAlignment="Center"
                                             Glyph="{dx:SvgImageSource Uri='/Assets/Icons/file-addition-one.svg'}"
                                             ToolTip="{loc:Translate 浏览}"
                                             Command="{Binding BrowseFolderCommand}"/>
                        </Grid>
                    </StackPanel>

                    <StackPanel Width="160" Margin="0,0,12,10">
                        <TextBlock Text="{loc:Translate 自定义名字}"
                                   Foreground="#666666" FontSize="11" Margin="0,0,0,3"
                                   TextTrimming="CharacterEllipsis"/>
                        <dxe:TextEdit VerticalAlignment="Center"
                                      Text="{Binding CustomFileName, UpdateSourceTrigger=PropertyChanged}"/>
                    </StackPanel>

                    <StackPanel Width="120" Margin="0,0,0,10">
                        <TextBlock Text="{loc:Translate 导出类型}"
                                   Foreground="#666666" FontSize="11" Margin="0,0,0,3"
                                   TextTrimming="CharacterEllipsis"/>
                        <dxe:ComboBoxEdit VerticalAlignment="Center"
                                          HorizontalAlignment="Stretch"
                                          ItemsSource="{Binding FormatOptions}"
                                          SelectedItem="{Binding FileFormat, Mode=TwoWay}"
                                          IsTextEditable="False"/>
                    </StackPanel>
                </WrapPanel>
            </dxlc:LayoutItem>

            <!-- 文件名预览：按当前目录、名字与类型展开占位符 -->
            <dxlc:LayoutItem Label="{loc:Translate 路径预览}">
                <dxe:TextEdit Text="{Binding PreviewFilePath, Mode=OneWay}"
                              IsReadOnly="True"/>
            </dxlc:LayoutItem>

            <!-- 占位符提示 -->
            <dxlc:LayoutItem Label="{x:Null}">
                <TextBlock Text="{loc:Translate 文件名占位符提示}"
                           Foreground="#888888" FontSize="11" TextWrapping="Wrap"/>
            </dxlc:LayoutItem>

        </dxlc:LayoutGroup>

        <!-- 未选中设备时整块不可编辑，就地说明原因 -->
        <TextBlock Text="{loc:Translate 未选择设备}"
                   Foreground="#E06C00" FontSize="12" Margin="4,0,0,0"
                   Visibility="{Binding HasNoDevice, Converter={StaticResource BoolToVis}}"/>

        <!-- ========== 分组2：自动应答规则 ========== -->
        <dxlc:LayoutGroup Header="{loc:Translate 自动应答规则}"
                          View="GroupBox" Orientation="Vertical">

            <!-- 第一行：按钮行 -->
            <dxlc:LayoutItem Label="{x:Null}">
                <WrapPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <dx:SimpleButton Height="28" Width="28" Margin="0,0,8,0"
                                     Glyph="{dx:SvgImageSource Uri='/Assets/Icons/add-one.svg'}"
                                     ToolTip="{loc:Translate 新增}"
                                     Command="{Binding AddAutoReplyCommand}"/>
                    <dx:SimpleButton Height="28" Width="28" Margin="0,0,8,0"
                                     Glyph="{dx:SvgImageSource Uri='/Assets/Icons/close.svg'}"
                                     ToolTip="{loc:Translate 删除}"
                                     Command="{Binding DeleteAutoReplyCommand}"/>
                    <dx:SimpleButton Height="28" Width="28" Margin="0,0,8,0"
                                     Glyph="{dx:SvgImageSource Uri='/Assets/Icons/upload-one.svg'}"
                                     ToolTip="{loc:Translate 导入配置}"
                                     Command="{Binding ImportCommand}"/>
                    <dx:SimpleButton Height="28" Width="28" Margin="0,0,8,0"
                                     Glyph="{dx:SvgImageSource Uri='/Assets/Icons/export.svg'}"
                                     ToolTip="{loc:Translate 导出配置}"
                                     Command="{Binding ExportCommand}"/>
                    <dx:SimpleButton Height="28" Width="28"
                                     Glyph="{dx:SvgImageSource Uri='/Assets/Icons/save.svg'}"
                                     ToolTip="{loc:Translate 保存配置}"
                                     Command="{Binding SaveCommand}"/>
                </WrapPanel>
            </dxlc:LayoutItem>

            <!-- 第二行：自动应答规则表格 -->
            <dxlc:LayoutItem Label="{x:Null}">
                <DataGrid ItemsSource="{Binding AutoReplyRules}"
                          SelectedItem="{Binding SelectedAutoReply}"
                          AutoGenerateColumns="False"
                          CanUserAddRows="False"
                          CanUserDeleteRows="False"
                          CanUserResizeColumns="True"
                          SelectionMode="Single"
                          MinHeight="140" MaxHeight="420"
                          CellEditEnding="AutoReplyGrid_CellEditEnding"
                          HorizontalScrollBarVisibility="Auto"
                          VerticalScrollBarVisibility="Auto"
                          GridLinesVisibility="All"
                          HeadersVisibility="Column">
                    <!-- 行颜色：命中过浅绿、停用灰显斜体（停用规则优先级在后） -->
                    <DataGrid.RowStyle>
                        <Style TargetType="DataGridRow">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding HasHit}" Value="True">
                                    <Setter Property="Background" Value="#E8F5E9"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding Enabled}" Value="False">
                                    <Setter Property="Background" Value="#F2F2F2"/>
                                    <Setter Property="Foreground" Value="#9E9E9E"/>
                                    <Setter Property="FontStyle" Value="Italic"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </DataGrid.RowStyle>
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="{loc:Translate 序号}"
                                            Binding="{Binding Index}"
                                            IsReadOnly="True"
                                            Width="60" MinWidth="50"/>
                        <DataGridTextColumn Header="{loc:Translate 命令}"
                                            Binding="{Binding Command, UpdateSourceTrigger=PropertyChanged}"
                                            Width="1.5*" MinWidth="100"/>
                        <DataGridTextColumn Header="{loc:Translate 预期}"
                                            Binding="{Binding Expected, UpdateSourceTrigger=PropertyChanged}"
                                            Width="1.2*" MinWidth="80"/>

                        <!-- 解析方式：下拉选择 exact/mask/regex，存储值不变，显示本地化文本 -->
                        <DataGridTemplateColumn Header="{loc:Translate 解析方式}"
                                                Width="110" MinWidth="90">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <ComboBox Margin="4"
                                              VerticalAlignment="Center"
                                              SelectedValuePath="Tag"
                                              SelectedValue="{Binding MatchMode, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}">
                                        <ComboBoxItem Tag="exact" Content="{loc:Translate 精确匹配}"/>
                                        <ComboBoxItem Tag="mask" Content="{loc:Translate 通配匹配}"/>
                                        <ComboBoxItem Tag="regex" Content="{loc:Translate 正则匹配}"/>
                                    </ComboBox>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <!-- 时间间隔：命中后延时毫秒数，仅允许整数输入 -->
                        <DataGridTemplateColumn Header="{loc:Translate 时间间隔}"
                                                Width="100" MinWidth="80">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Grid Margin="4">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <dxe:TextEdit Grid.Column="0"
                                                      VerticalAlignment="Center"
                                                      MaskType="Numeric"
                                                      Mask="d0"
                                                      AllowNullInput="False"
                                                      EditValue="{Binding DelayMs, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                                        <TextBlock Grid.Column="1" Margin="4,0,0,0"
                                                   VerticalAlignment="Center"
                                                   Foreground="#888888" Text="ms"/>
                                    </Grid>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <!-- 操作：SVG 开关（启用/停用自动下发）+ 行内删除 -->
                        <DataGridTemplateColumn Header="{loc:Translate 操作}"
                                                Width="90" MinWidth="80">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal"
                                                HorizontalAlignment="Center"
                                                VerticalAlignment="Center">
                                        <dx:SimpleButton Width="28" Height="28" Margin="2"
                                                         ButtonKind="Toggle"
                                                         IsChecked="{Binding Enabled, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                         ToolTip="{loc:Translate 启用自动下发}">
                                            <dx:SimpleButton.Style>
                                                <Style TargetType="dx:SimpleButton">
                                                    <Setter Property="Glyph"
                                                            Value="{dx:SvgImageSource Uri='/Assets/Icons/ON_power.svg'}"/>
                                                    <Style.Triggers>
                                                        <Trigger Property="IsChecked" Value="False">
                                                            <Setter Property="Glyph"
                                                                    Value="{dx:SvgImageSource Uri='/Assets/Icons/OFF_power.svg'}"/>
                                                        </Trigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </dx:SimpleButton.Style>
                                        </dx:SimpleButton>
                                        <dx:SimpleButton Width="28" Height="28" Margin="2"
                                                         Glyph="{dx:SvgImageSource Uri='/Assets/Icons/close.svg'}"
                                                         ToolTip="{loc:Translate 删除}"
                                                         Command="{Binding DataContext.DeleteRuleCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                         CommandParameter="{Binding}"/>
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <DataGridTextColumn Header="{loc:Translate 实际回复}"
                                            Binding="{Binding ActualReply, UpdateSourceTrigger=PropertyChanged}"
                                            Width="1.5*" MinWidth="100"/>
                    </DataGrid.Columns>
                </DataGrid>
            </dxlc:LayoutItem>

        </dxlc:LayoutGroup>

    </dxlc:LayoutControl>
    </ScrollViewer>
</UserControl>
