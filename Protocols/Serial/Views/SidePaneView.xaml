<UserControl x:Class="MultiSerialTool.Protocols.Serial.SidePaneView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:dx="http://schemas.devexpress.com/winfx/2008/xaml/core"
             xmlns:dxe="http://schemas.devexpress.com/winfx/2008/xaml/editors"
             xmlns:loc="clr-namespace:MultiSerialTool.Models.Localization"
             mc:Ignorable="d"
             d:DesignHeight="450" d:DesignWidth="240">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>

        <!-- 扁平拖宽条：默认浅灰，悬停/拖动高亮 -->
        <Style x:Key="FlatSplitter" TargetType="GridSplitter">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="GridSplitter">
                        <Border x:Name="PART_Border" Background="#D0D7E2"
                                Width="3" HorizontalAlignment="Stretch"/>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="PART_Border" Property="Background" Value="#7F8FA6"/>
                            </Trigger>
                            <Trigger Property="IsDragging" Value="True">
                                <Setter TargetName="PART_Border" Property="Background" Value="#3B82F6"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <!-- 左侧隐藏侧边栏：收合态仅留 24px 把手（分隔线在右缘） -->
    <Border Background="#F4F6F9"
            BorderBrush="#D0D7E2" BorderThickness="0,0,1,0">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="24"/>
            </Grid.ColumnDefinitions>

            <!-- 侧边栏内容：统一指令列表（复选框决定是否自动发送） -->
            <Grid Grid.Column="0" Margin="6,8"
                  Visibility="{Binding SidePaneOpen, Converter={StaticResource BoolToVis}}">
                <Border Background="White"
                        BorderBrush="#D0D7E2" BorderThickness="1"
                        CornerRadius="3">
                    <DockPanel>
                        <!-- 顶部第一行：标题 + 右侧 + / − -->
                        <Grid DockPanel.Dock="Top" Margin="6,4">
                            <TextBlock Text="{loc:Translate 指令列表}"
                                       FontWeight="SemiBold" Foreground="#5A6B82"
                                       VerticalAlignment="Center"/>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                <dx:SimpleButton Width="22" Height="22" Margin="2,0"
                                                 Glyph="{dx:SvgImageSource Uri='/Assets/Icons/add-one.svg'}"
                                                 ToolTip="{loc:Translate 新增}"
                                                 Command="{Binding AddCommandItemCommand}"/>
                                <dx:SimpleButton Width="22" Height="22" Margin="2,0"
                                                 Glyph="{dx:SvgImageSource Uri='/Assets/Icons/reduce-one.svg'}"
                                                 ToolTip="{loc:Translate 删除}"
                                                 Command="{Binding RemoveCommandItemCommand}"/>
                            </StackPanel>
                        </Grid>

                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <ItemsControl ItemsSource="{Binding CommandItems}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Grid x:Name="RowRoot" Margin="4,2">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <dx:SimpleButton Grid.Column="0" Padding="6,4"
                                                            HorizontalContentAlignment="Left"
                                                            ToolTip="{Binding ResultMessage}"
                                                            Command="{Binding DataContext.CommandClickCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                            CommandParameter="{Binding}">
                                                <StackPanel Orientation="Horizontal">
                                                    <!-- 自动发送复选框：拦截冒泡，避免勾选时触发整行发送 -->
                                                    <dxe:CheckEdit IsChecked="{Binding AutoSend, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                                   VerticalAlignment="Center"
                                                                   Margin="0,0,6,0"
                                                                   ToolTip="{loc:Translate 自动发送}"
                                                                   PreviewMouseLeftButtonDown="AutoSend_PreviewMouseDown"/>
                                                    <Ellipse Width="10" Height="10"
                                                             Fill="{Binding StatusBrush}"
                                                             VerticalAlignment="Center"
                                                             Margin="0,0,6,0"/>
                                                    <TextBlock Text="{Binding Name}"
                                                               VerticalAlignment="Center"
                                                               TextTrimming="CharacterEllipsis"/>
                                                </StackPanel>
                                            </dx:SimpleButton>

                                            <!-- 行操作：悬停显示竖排 ↑ ↓ ×，独立列避免遮挡命令名 -->
                                            <StackPanel x:Name="RowActions" Grid.Column="1"
                                                        Orientation="Vertical"
                                                        VerticalAlignment="Center"
                                                        Visibility="Collapsed">
                                                <dx:SimpleButton Width="16" Height="14" Margin="1,0"
                                                                 Padding="0"
                                                                 Glyph="{dx:SvgImageSource Uri='/Assets/Icons/up.svg'}"
                                                                 ToolTip="{loc:Translate 上移}"
                                                                 Command="{Binding DataContext.MoveCommandItemUpCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                                 CommandParameter="{Binding}"/>
                                                <dx:SimpleButton Width="16" Height="14" Margin="1,0"
                                                                 Padding="0"
                                                                 Glyph="{dx:SvgImageSource Uri='/Assets/Icons/down.svg'}"
                                                                 ToolTip="{loc:Translate 下移}"
                                                                 Command="{Binding DataContext.MoveCommandItemDownCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                                 CommandParameter="{Binding}"/>
                                            </StackPanel>
                                        </Grid>
                                        <DataTemplate.Triggers>
                                            <DataTrigger Binding="{Binding IsMouseOver, ElementName=RowRoot}" Value="True">
                                                <Setter TargetName="RowActions" Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                        </DataTemplate.Triggers>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </DockPanel>
                </Border>
            </Grid>

            <!-- 拖宽分隔条：仅展开时可用，位于内容与把手之间 -->
            <GridSplitter Grid.Column="1" Width="3"
                          HorizontalAlignment="Stretch"
                          Style="{StaticResource FlatSplitter}"
                          ShowsPreview="True"
                          DragCompleted="PaneSplitter_DragCompleted"
                          Visibility="{Binding SidePaneOpen, Converter={StaticResource BoolToVis}}"/>

            <!-- 把手：点击切换开合，竖排文字（透明无边框，不显示标准按钮底色） -->
            <Button Grid.Column="2" Command="{Binding TogglePaneCommand}"
                    Background="Transparent" BorderThickness="0" Padding="0"
                    ToolTip="{loc:Translate 快捷面板}">
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="&#171;" HorizontalAlignment="Center"
                               FontSize="12" Foreground="#5A6B82" Margin="0,0,0,6">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <!-- 收起（默认）：箭头指向左侧面板自身；展开：箭头指向右表示收起 -->
                                <Setter Property="Text" Value="&#171;"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding SidePaneOpen}" Value="True">
                                        <Setter Property="Text" Value="&#187;"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                    <TextBlock Text="{loc:Translate 快捷面板}" FontSize="12"
                               Foreground="#5A6B82">
                        <TextBlock.LayoutTransform>
                            <RotateTransform Angle="90"/>
                        </TextBlock.LayoutTransform>
                    </TextBlock>
                </StackPanel>
            </Button>
        </Grid>
    </Border>
</UserControl>
