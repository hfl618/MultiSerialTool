<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net9.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <AssemblyName>LoopbackTest</AssemblyName>
  </PropertyGroup>

  <!--
    用 dll 引用而非 ProjectReference：主项目是带 App.xaml 的 WPF 可执行项目，
    ProjectReference 会触发其 wpftmp 临时项目重新生成 AssemblyInfo，导致 CS0579
    重复程序集特性。引用已编译输出 dll 可避免该冲突；改主项目后请先构建主项目。
  -->
  <!-- 兄弟测试项目 FindMatcherTests 嵌套在本目录下，
       默认 glob 会把它的 Program.cs 与 obj 生成文件一起编入，
       导致 CS8802 多个顶级语句、CS0579 重复程序集特性，需显式排除。 -->
  <ItemGroup>
    <Compile Remove="FindMatcherTests\**\*.cs" />
    <Compile Remove="bin\**\*.cs" />
    <Compile Remove="obj\**\*.cs" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="MultiSerialTool-1.0.0-hfl">
      <HintPath>..\bin\Debug\net9.0-windows\MultiSerialTool-1.0.0-hfl.dll</HintPath>
    </Reference>
  </ItemGroup>

</Project>
