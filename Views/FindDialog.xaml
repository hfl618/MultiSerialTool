<Window x:Class="MultiSerialTool.Views.FindDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:d="http://schemas.microsoft.com/expression/blend/1006"
        xmlns:dx="http://schemas.devexpress.com/winfx/2008/xaml/core"
        xmlns:loc="clr-namespace:MultiSerialTool.Models.Localization"
        mc:Ignorable="d"
        Title="{loc:Translate 查找}"
        Width="440" SizeToContent="Height"
        Topmost="True"
        ShowInTaskbar="False"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        Background="#F5F5F5" Foreground="#222222">
    <Window.Resources>
        <loc:LocConverter x:Key="LocConverter"/>
    </Window.Resources>

    <StackPanel Margin="10,8">

        <!-- 第一行：关键字输入 + 上一个/下一个图标按钮 + 关闭 -->
        <StackPanel Orientation="Horizontal">
            <TextBox x:Name="KeywordBox"
                     Width="250" Height="28"
                     VerticalContentAlignment="Center"
                     FontSize="13"
                     Text="{Binding Keyword, UpdateSourceTrigger=PropertyChanged}"
                     PreviewKeyDown="KeywordBox_PreviewKeyDown"/>

            <!-- 上一个：up-square.svg -->
            <dx:SimpleButton x:Name="BtnPrevious" Margin="6,0,0,0"
                             Width="30" Height="28"
                             ToolTip="{loc:Translate 上一个}"
                             Glyph="{dx:SvgImageSource Uri='/Assets/Icons/up-square.svg'}"
                             GlyphWidth="16" GlyphHeight="16"
                             Command="{Binding FindPreviousCommand}"/>

            <!-- 下一个：down-square.svg -->
            <dx:SimpleButton x:Name="BtnNext" Margin="4,0,0,0"
                             Width="30" Height="28"
                             ToolTip="{loc:Translate 下一个}"
                             Glyph="{dx:SvgImageSource Uri='/Assets/Icons/down-square.svg'}"
                             GlyphWidth="16" GlyphHeight="16"
                             Command="{Binding FindNextCommand}"/>

            <dx:SimpleButton x:Name="BtnClose" Margin="8,0,0,0"
                             Width="56" Height="28"
                             Content="{loc:Translate 关闭}"
                             Click="BtnClose_Click"/>
        </StackPanel>

        <!-- 第二行：匹配方式 + 区分大小写 + 过滤模式 -->
        <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
            <TextBlock Text="{loc:Translate 匹配方式：}" VerticalAlignment="Center"
                       Margin="0,0,4,0"/>
            <ComboBox x:Name="ModeBox" Width="86" Height="26"
                      VerticalContentAlignment="Center"
                      ItemsSource="{Binding ModeOptions}"
                      SelectedItem="{Binding SelectedMode}">
                <!-- 内部标识不变，仅显示层翻译 -->
                <ComboBox.ItemTemplate>
                    <DataTemplate>
                        <TextBlock Text="{Binding Converter={StaticResource LocConverter}}"/>
                    </DataTemplate>
                </ComboBox.ItemTemplate>
            </ComboBox>

            <CheckBox Content="{loc:Translate 区分大小写}"
                      VerticalAlignment="Center" Margin="12,0,0,0"
                      IsChecked="{Binding MatchCase}"/>

            <CheckBox Content="{loc:Translate 过滤}"
                      VerticalAlignment="Center" Margin="12,0,0,0"
                      IsChecked="{Binding IsFilterMode}"/>
        </StackPanel>

        <!-- 第三行：过滤语法提示 + 命中状态 -->
        <Grid Margin="0,6,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0"
                       Text="{loc:Translate 过滤提示：| 表示或，\ 表示与}"
                       Foreground="#888888" FontSize="12"
                       TextWrapping="Wrap"/>
            <TextBlock Grid.Column="1" x:Name="StatusBlock"
                       Text="{Binding StatusText}"
                       Foreground="#1A72BB" FontSize="12"
                       Margin="8,0,0,0"
                       VerticalAlignment="Center"/>
        </Grid>
    </StackPanel>
</Window>
