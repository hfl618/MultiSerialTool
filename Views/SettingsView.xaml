<UserControl x:Class="MultiSerialTool.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:loc="clr-namespace:MultiSerialTool.Models.Localization"
             mc:Ignorable="d"
             d:DesignHeight="450" d:DesignWidth="800">
    <Grid Margin="12">
        <DockPanel LastChildFill="True">
            <!-- 返回按钮：设置页 DataContext 是 SettingsViewModel，
                 用 RelativeSource 找到主窗口的 MainViewModel 上的命令 -->
            <Button Content="{loc:Translate 返回设备区}"
                    DockPanel.Dock="Right"
                    HorizontalAlignment="Right"
                    Padding="12,4"
                    Command="{Binding DataContext.ShowWorkspaceCommand,
                              RelativeSource={RelativeSource AncestorType=Window}}"/>
            <TextBlock Text="{loc:Translate 设置}" FontSize="18" FontWeight="SemiBold" VerticalAlignment="Center"/>
        </DockPanel>
    </Grid>
</UserControl>
