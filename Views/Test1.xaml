<UserControl x:Class="MultiSerialTool.Views.Test1"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:MultiSerialTool.Views"
             mc:Ignorable="d"
             d:DesignHeight="450" d:DesignWidth="800">
    <ScrollViewer VerticalScrollBarVisibility="Disabled"
                  HorizontalScrollBarVisibility="Auto">
        <Grid Margin="24">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Grid Margin="0,0,0,12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0"
                           Text="测试任务："
                           VerticalAlignment="Center"
                           Margin="0,0,8,0"/>
                <ComboBox Grid.Column="1"
                          MinWidth="260"
                          ItemsSource="{Binding TestTasks}"
                          SelectedItem="{Binding SelectedTask, Mode=TwoWay}"/>
            </Grid>

            <Grid Grid.Row="1" Margin="0,0,0,12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="{Binding CurrentItemText}" Margin="0,0,0,8"/>
                    <ProgressBar Height="18"
                                 Minimum="0"
                                 Maximum="100"
                                 Value="{Binding Progress, Mode=OneWay}" />
                </StackPanel>

                <Button Grid.Column="1"
                        Width="100"
                        Height="34"
                        Margin="16,0,8,0"
                        Content="下一步"
                        Command="{Binding NextCommand}"/>
                <Button Grid.Column="2"
                        Width="100"
                        Height="34"
                        Content="重置"
                        Command="{Binding ResetCommand}"/>
            </Grid>

            <StackPanel Grid.Row="2" Margin="0,0,0,8">
                <TextBlock FontWeight="SemiBold" Text="测试状态" Margin="0,0,0,4"/>
                <TextBlock Text="{Binding StatusText}" TextWrapping="Wrap"/>
                <TextBlock Margin="0,4,0,0"
                           Foreground="#C62828"
                           TextWrapping="Wrap"
                           Text="{Binding LastExportPath, TargetNullValue=''}"/>
            </StackPanel>

            <Border Grid.Row="3"
                    MinHeight="160"
                    BorderBrush="#CCCCCC"
                    BorderThickness="1"
                    Padding="8">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <TextBlock Text="测试相关 Log"
                               FontWeight="SemiBold"
                               Margin="0,0,0,8"/>
                    <ListBox Grid.Row="1"
                             BorderThickness="0"
                             FontFamily="Consolas"
                             ItemsSource="{Binding TestLogs}"
                             ScrollViewer.HorizontalScrollBarVisibility="Auto">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock>
                                        <Run Text="{Binding Time, StringFormat=HH:mm:ss.fff}"/>
                                        <Run Text="{Binding Direction}"/>
                                        <Run Text="{Binding TestName}"/>
                                    </TextBlock>
                                    <!-- HEX 视图：跟随 IsHexDisplay，无 HEX 时回退文本 -->
                                    <TextBlock Margin="6,0,0,0">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding DataContext.IsHexDisplay, RelativeSource={RelativeSource AncestorType=ListBox}}" Value="True">
                                                        <Setter Property="Visibility" Value="Visible"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding Hex}" Value="">
                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                        <Run Text="{Binding Hex}"/>
                                    </TextBlock>
                                    <!-- ASCII 文本视图 -->
                                    <TextBlock Margin="6,0,0,0">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Visibility" Value="Visible"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding DataContext.IsHexDisplay, RelativeSource={RelativeSource AncestorType=ListBox}}" Value="True">
                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding Hex}" Value="">
                                                        <Setter Property="Visibility" Value="Visible"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                        <Run Text="{Binding Text}"/>
                                    </TextBlock>
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Grid>
            </Border>
        </Grid>
    </ScrollViewer>
</UserControl>
