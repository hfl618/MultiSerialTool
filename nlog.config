<?xml version="1.0" encoding="utf-8" ?>
<!--
  NLog 配置（MultiSerialTool）

  双通道设计：
    1. asyncFile ：常规日志（Debug/Info/Warn）走 AsyncWrapper 后台队列落盘，
                   调用线程只做内存入队（约 50–200ns），不被磁盘 I/O 阻塞。
                   overflowAction="Block"：队列满时反压调用方，不丢弃日志（测试记录不丢口径）。
    2. errorFile ：Error 级别同步直写，不经异步队列；崩溃/强杀瞬间致命错误也尽量落盘。

  日志目录不在此文件写死，由 LogService 启动/切换目录时写入变量 ${var:logDirectory}。
  行格式与原自研 LogService 保持一致：
    HH:mm:ss.fff [LEVEL/Source] Operation: Message
-->
<nlog xmlns="http://www.nlog-project.org/schemas/NLog.xsd"
      xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
      autoReload="true"
      internalLogLevel="Warn"
      internalLogFile="${specialfolder:folder=LocalApplicationData}/MultiSerialTool/NLog-internal.log">

  <targets>

    <!-- 常规日志：异步后台队列写文件 -->
    <target xsi:type="AsyncWrapper" name="asyncFile"
            queueLimit="10000"
            overflowAction="Block"
            batchSize="200"
            timeToSleepBetweenBatches="0">
      <target xsi:type="File" name="asyncInnerFile"
              fileName="${var:logDirectory}/log_${date:format=yyyyMMdd}.txt"
              layout="${event-properties:item=Stamp} [${level:uppercase=true}/${event-properties:item=Source}] ${message}${exception:format=toString}"
              keepFileOpen="true"
              archiveAboveSize="104857600"
              archiveNumbering="Rolling"
              maxArchiveFiles="10"
              encoding="utf-8"
              autoFlush="true" />
    </target>

    <!-- Error 级别：同步直写，不经异步队列 -->
    <target xsi:type="File" name="errorFile"
            fileName="${var:logDirectory}/log_${date:format=yyyyMMdd}.txt"
            layout="${event-properties:item=Stamp} [${level:uppercase=true}/${event-properties:item=Source}] ${message}${exception:format=toString}"
            keepFileOpen="true"
            encoding="utf-8"
            autoFlush="true" />

  </targets>

  <rules>
    <!-- Error 走同步通道；其余级别走异步通道 -->
    <logger name="*" minlevel="Error" writeTo="errorFile" />
    <logger name="*" levels="Debug,Info,Warn" writeTo="asyncFile" />
  </rules>

</nlog>
